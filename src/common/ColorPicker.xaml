<Window x:Class="Iris.Common.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Title="Select Color"
        Height="160"
        Width="240"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <DockPanel Margin="15">

        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">

            <Button Width="80"
                    Margin="0,0,10,0"
                    Content="OK"
                    IsDefault="True"
                    Click="Ok_Click"/>

            <Button Width="80"
                    Content="Cancel"
                    IsCancel="True"
                    Click="Cancel_Click"/>
        </StackPanel>

        <xctk:ColorPicker x:Name="colorPicker" Width="80" Height="32"/>

    </DockPanel>
</Window>